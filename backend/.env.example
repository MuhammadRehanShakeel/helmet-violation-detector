# Copy this file to .env and fill it in. .env is never uploaded to GitHub.

# --- SQL Server (RoadGuard gets its own database) ---
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=RoadGuard
DB_AUTH=windows
# Only for DB_AUTH=sql:
DB_USER=
DB_PASSWORD=
DB_DRIVER=ODBC Driver 17 for SQL Server

# --- Security ---
# Long random text. Make one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=120

# --- Server ---
API_HOST=127.0.0.1
API_PORT=5001
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# --- AI model (file inside backend/models/) ---
MODEL_FILE=roadguard_yolo11n.onnx
CPU_THREADS=4

# --- E-challan ---
CHALLAN_AUTHORITY=RoadGuard Demo Traffic Unit
PUBLIC_BASE_URL=http://localhost:5174
